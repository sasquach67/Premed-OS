          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "authority": {
          "enum": [
            "official",
            "student-request",
            "selected-material"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200000
          },
          "minItems": 0,
          "maxItems": 5000
        },
        "excerptIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
